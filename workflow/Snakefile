configfile: 'config/config.yaml'

from pathlib import Path
import os

results = Path(config['output_directory'])
fastq_folder = Path(config['fastq_folder'])
final_merged_vcf = results / 'clair3_multisample' / 'merged_multisample.vcf.gz'

all_samples = [f.name.replace('.fastq.gz', '') for f in fastq_folder.glob('*.fastq.gz')]
sample_subset = config['sample_subset']

rule all:
	input:
		# rules.snpeff_all.input,
		# merged_vcf = final_merged_vcf,
		copied_snakefile = results / 'config' / 'Snakefile',
		copied_config = results / 'config' / 'config.yaml',
		copied_targets = results / 'config' / 'targets.tsv',
		clair3_vcf = expand(results / 'clair3_samples' / "{sample}" / 'merge_output.vcf.gz', sample = all_samples)

