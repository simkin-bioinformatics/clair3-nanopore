rule copy_files:
	input:
		original_snakefile = 'workflow/Snakefile',
		original_config = 'config/config.yaml',
		original_targets = config['targets_tsv'],
	output:
		copied_snakefile = results / 'config' / 'Snakefile',
		copied_config = results / 'config' / 'config.yaml',
		copied_targets = results / 'config' / 'targets.tsv',
	shell:
		'''
		cp {input.original_snakefile} {output.copied_snakefile}
		cp {input.original_config} {output.copied_config}
		cp {input.original_targets} {output.copied_targets}
		'''

rule run_minimap:
	input:
		genome = config['genome_fasta'],
		sample = fastq_folder / '{sample}.fastq.gz'
	output:
		aligned_sam = results / 'sam_files' / '{sample}_output.sam'
	shell:
		'minimap2 -ax map-ont -o {output.aligned_sam} {input.genome} {input.sample}'

rule index_genome:
	input:
		genome = config['genome_fasta']
	output:
		genome_index = config['genome_fasta'] + '.fai'
	shell:
		'samtools faidx {input.genome}'

rule index_and_sort_sam:
	input:
		aligned_sam = results / 'sam_files' / '{sample}_output.sam'
	output:
		sorted_bam = results / 'sorted_bam_files' / '{sample}_output_sorted.bam',
		indexed_bam = results / 'sorted_bam_files' / "{sample}_output_sorted.bam.csi",
	shell:
		'''
		samtools sort --write-index -o {output.sorted_bam} {input.aligned_sam}
		'''

rule run_clair3:
	input:
		genome = config['genome_fasta'],
		genome_index = config['genome_fasta']+'.fai',
		indexed_bam = results / 'sorted_bam_files' / "{sample}_output_sorted.bam.csi",
		sorted_bam = results / 'sorted_bam_files' / "{sample}_output_sorted.bam",
	params:
		model_path = config['model_path'],
		snp_min_af = config['snp_min_af'],
		indel_min_af = config['indel_min_af'],
	output:
		clair3_vcf = results / 'clair3_samples' / "{sample}" / 'merge_output.vcf.gz'
	shell:
		'''
		run_clair3.sh \
			--bam_fn={input.sorted_bam} \
			--ref_fn={input.genome} \
			--threads=6 \
			--platform=ont \
			--model_path={params.model_path} \
			--output=$(dirname {output.clair3_vcf}) \
			--print_ref_calls \
			--include_all_ctgs \
			--gvcf \
			--no_phasing_for_fa \
			--sample_name={wildcards.sample} \
			--snp_min_af={params.snp_min_af} \
			--indel_min_af={params.indel_min_af}
		'''

